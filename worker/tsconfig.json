{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["./**/*.ts", "../src/shared/**/*.ts", "../src/game/logic.ts", "../src/game/types.ts", "../src/i18n/words.ts"]
}
